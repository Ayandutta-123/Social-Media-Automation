# Postgres Connection
DATABASE_URL="postgresql://username:password@host:port/database"

# Notion API Credentials
NOTION_TOKEN="secret_your_notion_integration_token"
NOTION_DATABASE_ID="your_notion_database_id"

# n8n Webhook URLs
N8N_WEBHOOK_COMPETITOR="https://your-n8n-instance/webhook/competitor-scrape"
N8N_WEBHOOK_TRENDS="https://your-n8n-instance/webhook/trend-research"

# Custom image upload webhooks
N8N_WEBHOOK_IMAGE_UPLOAD_COMPETITOR=""
N8N_WEBHOOK_IMAGE_UPLOAD_INDUSTRY=""

# Cloudinary (for custom image uploads)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Admin Login Credentials
ADMIN_USERNAME="your_username"
ADMIN_PASSWORD="your_password"
